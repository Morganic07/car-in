# Car'in — variables d'environnement attendues.
# Copier ce fichier en .env et remplir les valeurs vides. Le .env n'est jamais versionné.

# --- Base de données ------------------------------------------------------------
# SQLite, un simple fichier. Valeur par défaut utilisable telle quelle en local.
DATABASE_URL="file:./dev.db"

# --- Authentification ----------------------------------------------------------
# Secret de signature des sessions. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# 1 seulement si UN SEUL proxy (hébergeur, reverse proxy) est placé devant
# l'application, et qu'il AJOUTE l'adresse IP du client EN FIN de l'en-tête
# x-forwarded-for (nginx : proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
# L'application lit la valeur la plus à droite, celle posée par ce proxy : tout ce
# qui précède est écrit par le client. Avec plusieurs proxys en chaîne, la valeur de
# droite serait l'adresse du proxy intermédiaire — configuration non prise en charge.
# Sans proxy, cet en-tête est écrit par le client lui-même : les limites de débit
# par adresse IP ne le lisent alors pas, et un plafond global s'applique à la place.
# Laisser vide en local.
CONFIANCE_PROXY=

# Mot de passe des comptes de démonstration posés par `npm run seed` (8 caractères
# minimum). Vide : les comptes sont créés sans mot de passe et ne peuvent pas se
# connecter. Ne jamais le définir sur un serveur où de vrais clients ont un compte.
DEMO_MOT_DE_PASSE=

# --- Estimation de distance et de durée ----------------------------------------
# Clé gratuite à créer sur openrouteservice.org (quota quotidien du point d'accès
# « directions » : 2 000 à 2 500 selon les sources ; l'application se plafonne à
# 1 500 estimations par jour UTC, toutes clientèles confondues).
# Sans clé, l'application reste utilisable : le prix s'affiche « confirmé par la
# compagnie » au lieu d'une estimation. Aucun calcul de repli n'est effectué.
ORS_API_KEY=

# --- Grille tarifaire (euros) --------------------------------------------------
# Prix estimé = TARIF_BASE_EUR + (km x TARIF_PAR_KM_EUR) + (min x TARIF_PAR_MIN_EUR)
# À renseigner avec les tarifs réels de la compagnie avant toute démonstration.
TARIF_BASE_EUR=
TARIF_PAR_KM_EUR=
TARIF_PAR_MIN_EUR=
